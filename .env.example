# Optional. Non-AI extraction works without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Explicit opt-in for your own localhost/private apps. In Docker use host.docker.internal.
ALLOW_LOCAL_TARGETS=false
# Native development only; Compose sets HOST=0.0.0.0 inside its localhost-published container.
HOST=127.0.0.1
PORT=3100
DATA_DIR=./data
