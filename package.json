{
  "name": "context-local",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter web build && pnpm --filter server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter server test",
    "test:integration": "pnpm --filter server test:integration",
    "test:ui": "pnpm --filter server test:ui",
    "start": "pnpm --filter server start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
